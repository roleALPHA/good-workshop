out/
build/
coverage/
test-results/
playwright-report/
*.tsbuildinfo
next-env.d.ts
.env
.env.local
.env*.local
.DS_Store
blob-report/
.playwright/
e2e/.auth/

# Werkzeug-spezifische lokale Konfiguration. Die verbindlichen Konventionen
# liegen als normale Dokumente in docs/ -- sie gelten fuer jeden Beitrag, nicht
# nur fuer den, der mit einem bestimmten Werkzeug arbeitet.
.claude/
CLAUDE.md
**/CLAUDE.md
# Written by `next build` alongside CLAUDE.md, same reason.
AGENTS.md
dist/

# What the cloud build brings with it and what it writes. The accounting and
# payment adapters are copied in from the private repository (GW_BILLING_ADAPTERS),
# and the invoices captured with them are real documents from a real accounting
# system -- neither belongs in a repository anybody can clone.
private-adapters/
artifacts/

# Generated by scripts/licenses.mjs when a release is built. The reviewable
# half -- THIRD-PARTY-LICENSES.md, without versions -- IS committed; these two
# carry version numbers and licence texts and would churn on every bump.
THIRD-PARTY-LICENSES.txt
sbom.cdx.json
