# Pflicht. Leitet Anmeldelinks und die WebAuthn-Origin ab.
GW_APP_URL=https://workshop.example.com

# Pflicht für das Profil `tls`. Wird an den Caddy-Container durchgereicht und
# dort im Caddyfile eingesetzt.
GW_HOSTNAME=workshop.example.com

# WebAuthn Relying Party ID. Leer lassen = Host aus GW_APP_URL.
# ACHTUNG: eine spätere Änderung macht alle registrierten Passkeys ungültig.
GW_RP_ID=

# Pflicht: console | smtp | none. Bewusst ohne Standardwert.
#
# `console` druckt VOLLSTÄNDIGE, GÜLTIGE Anmeldelinks in die Container-Logs.
# Für eine Installation ohne Mailrelay ist das der vorgesehene Weg -- aber wer
# die Logs lesen kann (Docker-Gruppe, Log-Aggregator, ein an den Support
# geschickter Auszug, ein Backup), kann sich für jede Adresse einen Link
# ausstellen lassen und damit das Konto übernehmen. Beim Start wird gewarnt.
GW_MAIL_TRANSPORT=smtp

# Enthält Benutzer und Passwort. Besser als Environment: SMTP_URL_FILE auf eine
# Datei zeigen lassen (Docker Secret) -- eine Environment-Variable steht in
# `docker inspect`, in /proc/<pid>/environ und in jedem Core-Dump.
SMTP_URL=
SMTP_URL_FILE=
SMTP_FROM=

# Legt beim allerersten Start einen Admin an und druckt einen einmaligen
# Anmeldelink auf stdout. Danach wieder entfernen.
GW_BOOTSTRAP_ADMIN_EMAIL=

# Pflicht: der Image-Tag, der laufen soll. Bewusst ohne Standardwert -- ein
# beweglicher Tag heißt, dass zwei Container desselben Stacks verschiedene
# Stände fahren können und niemand sagen kann, welcher Code lief.
GW_VERSION=v0.1.0

# Port auf 127.0.0.1, falls der Standard belegt ist.
GW_PORT=3000

# Der Kollaborations-Dienst laeuft im selben Container auf einem eigenen Port.
# Der Proxy leitet /collab dorthin.
GW_COLLAB_PORT=3001

# Nur noetig, wenn der Dienst NICHT unter /collab auf demselben Hostnamen
# erreichbar ist. Leer lassen heisst: gleiche Herkunft, Pfad /collab.
GW_COLLAB_URL=

# Die Adresse, unter der die App selbst den Dienst erreicht, wenn ein
# MCP-Schreibvorgang einem Raum beitritt. Getrennt von GW_COLLAB_URL, weil der
# Browser durch den Proxy geht und dieser Prozess dahinter steht.
# Standard: ws://127.0.0.1:${GW_COLLAB_PORT}/collab -- passt fuer das Image.
GW_COLLAB_INTERNAL_URL=

# Optional. Ohne diesen Wert gibt /api/health nur Status und Prüfungsnamen
# heraus -- der Endpunkt ist öffentlich erreichbar. Ist er gesetzt, liefert
# ein Aufruf mit dem Header `x-ops-token: <Wert>` zusätzlich Version,
# Migrationsstand und Treiberfehler im Klartext.
GW_OPS_TOKEN=

# Anzahl der Proxys vor der Anwendung. Bestimmt, welcher Eintrag aus
# X-Forwarded-For als Absenderadresse gilt -- ausschließlich für Drosselung und
# Logs, niemals für eine Berechtigung. Mit dem `tls`-Profil ist es genau einer.
GW_TRUSTED_PROXIES=1

# Wie lange eine Session ungenutzt bleiben darf, unabhängig von der absoluten
# Lebensdauer.
GW_SESSION_IDLE_DAYS=14
