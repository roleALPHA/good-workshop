# Serves the built help site inside its container. TLS, the host name and the
# language redirect on / are the outer proxy's business; this only answers on
# :8080 for whoever forwards to it.
{
	admin off
	auto_https off
}

:8080 {
	root * /srv
	encode zstd gzip

	# Hashed file names: a new build has new names, so these never go stale.
	@hashed path /_astro/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"
	header -Server

	file_server
	handle_errors 404 {
		rewrite * /404.html
		file_server
	}
}
