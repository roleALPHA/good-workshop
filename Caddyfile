# Automatisches HTTPS von Let's Encrypt. Der Hostname muss öffentlich auf
# diesen Server auflösen, sonst schlägt die Ausstellung fehl.
#
# Passkeys hängen an genau diesem Namen (GW_RP_ID). Eine spätere Änderung
# macht alle registrierten Passkeys ungültig.
{$GW_HOSTNAME} {
	encode zstd gzip

	# Die Anwendung setzt ihre eigenen Sicherheitsheader (src/middleware.ts):
	# CSP mit Nonce, frame-ancestors, nosniff, Referrer- und Permissions-Policy,
	# HSTS. Lange stand hier, sie täte das -- sie tat es nicht, und dieser
	# Kommentar war der Grund, dass niemand nachsah.
	#
	# HSTS bleibt zusätzlich hier: dieser Block ist die Stelle, an der TLS
	# tatsächlich terminiert, und er gilt auch für Antworten, die gar nicht erst
	# bei der Anwendung ankommen.
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
	}

	# Live-Kollaboration: eigener Prozess, eigener Port, gleicher Hostname.
	# Caddy leitet den WebSocket-Upgrade unverändert weiter -- ohne diesen
	# Block landete er beim Next-Server, der ihn nicht bedienen kann.
	handle /collab* {
		reverse_proxy app:3001
	}

	reverse_proxy app:3000 {
		# Next.js streamt Server-Komponenten; Puffern ließe die Seite erst
		# am Stück erscheinen.
		flush_interval -1
	}
}
