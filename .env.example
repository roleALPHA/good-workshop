# Values for an on-premise installation. Copy to .env and fill in.
#
# None of this is a database password: the stack generates those itself on first
# start, into volumes of their own. See compose.yaml.

# Required. Sign-in links and the WebAuthn origin are derived from it.
GW_APP_URL=https://workshop.example.com

# Required for the `tls` profile. Passed through to the Caddy container and used
# there in the Caddyfile.
GW_HOSTNAME=workshop.example.com

# WebAuthn relying party id. Leave empty = host from GW_APP_URL.
# CAREFUL: changing it later invalidates every registered passkey.
GW_RP_ID=

# Required: smtp | graph | console | none. Deliberately without a default.
#
# `console` prints COMPLETE, VALID sign-in links into the container logs. For an
# installation with no mail relay that is the intended route -- but anybody who
# can read the logs (the docker group, a log aggregator, an excerpt sent to
# support, a backup) can have a link issued for any address and take over that
# account. There is a warning at startup.
GW_MAIL_TRANSPORT=smtp

# Contains a user and a password. Better than the environment: point
# SMTP_URL_FILE at a file -- an environment variable shows up in
# `docker inspect`, in /proc/<pid>/environ and in every core dump. The database
# passwords take that same route and are generated on first start; there is
# nothing to enter for them here.
SMTP_URL=
SMTP_URL_FILE=
SMTP_FROM=

# Only with GW_MAIL_TRANSPORT=graph. Delivery through Microsoft Graph, for
# Microsoft 365 tenants with SMTP AUTH switched off.
#
# You need an app registration with the APPLICATION PERMISSION `Mail.Send` (with
# admin consent) and the mailbox to send from. GW_GRAPH_CLIENT_SECRET_FILE is
# preferable to the direct value.
GW_GRAPH_TENANT_ID=
GW_GRAPH_CLIENT_ID=
GW_GRAPH_CLIENT_SECRET=
GW_GRAPH_CLIENT_SECRET_FILE=
GW_GRAPH_SENDER=

# Creates an admin on the very first start and prints a one-time sign-in link to
# stdout. Remove it again afterwards.
GW_BOOTSTRAP_ADMIN_EMAIL=

# Required: the image tag that should run. Deliberately without a default -- a
# moving tag means two containers of the same stack can run different revisions
# and nobody can say which code ran.
GW_VERSION=v0.3.1

# Time zone for dates in the interface. Set explicitly rather than inferred:
# without it the server formats in the server's zone and the browser in the
# visitor's, so the same timestamp renders two ways and React reports a
# hydration mismatch on a page nobody changed.
GW_TIMEZONE=Europe/Berlin

# Port on 127.0.0.1, in case the default is taken.
GW_PORT=3000

# The collaboration service runs in the same container on a port of its own.
# The proxy forwards /collab there.
GW_COLLAB_PORT=3001

# Only needed if the service is NOT reachable at /collab on the same hostname.
# Leaving it empty means: same origin, path /collab.
GW_COLLAB_URL=

# The address at which the app itself reaches the service when an MCP write
# joins a room. Separate from GW_COLLAB_URL because the browser goes through the
# proxy and this process sits behind it.
# Default: ws://127.0.0.1:${GW_COLLAB_PORT}/collab -- right for the image.
GW_COLLAB_INTERNAL_URL=

# Encrypts the credentials an administrator enters in the interface (SMTP URL,
# Graph secret). Leave empty: the stack then generates it on first start, into a
# volume of its own.
#
# CAREFUL: this key belongs in the backup. A restored dump without it comes back
# with empty credentials -- everything else survives, but the mail credentials
# have to be entered again.
GW_SECRET_KEY=
GW_SECRET_KEY_FILE=

# Optional. Without this value /api/health hands out only the status and the
# check names -- the endpoint is publicly reachable. With it set, a call
# carrying the header `x-ops-token: <value>` additionally returns the version,
# the migration state and the driver error in the clear.
GW_OPS_TOKEN=

# Number of proxies in front of the application. Decides which entry from
# X-Forwarded-For counts as the sender address -- for throttling and logs only,
# never for a permission. With the `tls` profile it is exactly one.
GW_TRUSTED_PROXIES=1

# How long a session may sit unused, independent of its absolute lifetime.
GW_SESSION_IDLE_DAYS=14
